/* The demo's screen: the panel on the left, the HUD at the bottom, bars and words over the units. */

.demo-root {
    flex-grow: 1;
    font-size: 13px;
    color: rgb(230, 232, 236);
}

.demo-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* The panel */

.demo-panel {
    position: absolute;
    left: 12px;
    top: 12px;
    bottom: 12px;
    width: 330px;
    background-color: rgba(18, 20, 26, 0.88);
    border-radius: 6px;
    padding: 10px;
}

.demo-title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.demo-section {
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.demo-section__title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(170, 190, 220);
    margin-bottom: 4px;
}

.demo-subtitle {
    -unity-font-style: bold;
    margin-top: 6px;
    margin-bottom: 2px;
    color: rgb(190, 196, 206);
}

.demo-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
}

.demo-row__label {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.demo-row__value {
    min-width: 48px;
    -unity-text-align: middle-right;
    margin-right: 4px;
    color: rgb(200, 210, 225);
}

.demo-field {
    width: 170px;
    margin: 1px 0;
}

.demo-field .unity-base-field__input {
    background-color: rgb(40, 44, 54);
    border-color: rgb(70, 78, 96);
    color: rgb(230, 232, 236);
}

.demo-field .unity-base-popup-field__text {
    color: rgb(230, 232, 236);
}

.demo-field .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(200, 206, 216);
}

.demo-button {
    min-width: 26px;
    height: 20px;
    margin: 1px 2px;
    padding: 0 6px;
    border-radius: 3px;
    background-color: rgb(52, 58, 72);
    border-width: 0;
    color: rgb(230, 232, 236);
}

.demo-button:hover {
    background-color: rgb(70, 78, 96);
}

.demo-button:active {
    background-color: rgb(90, 100, 124);
}

.demo-button:disabled {
    opacity: 0.4;
}

.demo-help {
    white-space: normal;
    color: rgb(165, 172, 184);
    font-size: 12px;
    margin: 2px 0 4px 0;
}

/* The HUD */

.demo-hud {
    position: absolute;
    left: 360px;
    right: 12px;
    bottom: 12px;
    background-color: rgba(18, 20, 26, 0.88);
    border-radius: 6px;
    padding: 8px 12px;
}

.demo-hud__hero {
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.demo-hud__cast {
    color: rgb(255, 215, 120);
    min-height: 16px;
}

.demo-hud__lower {
    flex-direction: row;
    margin-top: 6px;
}

.demo-bar {
    margin: 2px 0;
}

.demo-bar__track {
    height: 16px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 3px;
    overflow: hidden;
}

.demo-bar__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.demo-bar__text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(245, 245, 245);
}

.demo-bar--health .demo-bar__fill {
    background-color: rgb(78, 170, 92);
}

.demo-bar--mana .demo-bar__fill {
    background-color: rgb(70, 120, 210);
}

.demo-bar--unit {
    position: absolute;
    width: 110px;
}

.demo-bar--unit .demo-bar__track {
    height: 10px;
}

.demo-bar--unit .demo-bar__fill {
    background-color: rgb(200, 80, 70);
}

.demo-bar--unit .demo-bar__text {
    font-size: 8px;
}

.demo-bar__title {
    -unity-text-align: middle-center;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.8);
}

.demo-slots {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.demo-slot {
    width: 64px;
    height: 64px;
    margin-right: 6px;
    border-radius: 4px;
    background-color: rgb(40, 44, 54);
    -unity-background-scale-mode: scale-to-fit;
    justify-content: space-between;
}

.demo-slot--cooling {
    -unity-background-image-tint-color: rgb(110, 110, 110);
}

.demo-slot--casting {
    border-width: 2px;
    border-color: rgb(255, 215, 120);
}

.demo-slot__key {
    -unity-font-style: bold;
    font-size: 12px;
    padding: 1px 4px;
    color: rgb(255, 255, 255);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.9);
}

.demo-slot__cooldown {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.9);
}

.demo-slot__name {
    font-size: 9px;
    -unity-text-align: lower-center;
    white-space: normal;
    padding: 0 2px 2px 2px;
    color: rgb(240, 240, 240);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.9);
}

.demo-attributes {
    flex-direction: row;
    flex-wrap: wrap;
    width: 55%;
}

.demo-attribute {
    width: 33%;
    min-height: 18px;
    font-size: 12px;
}

.demo-buffs {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    align-content: flex-start;
}

.demo-effect {
    background-color: rgb(44, 50, 62);
    border-radius: 3px;
    padding: 2px 6px 2px 22px;
    margin: 0 4px 4px 0;
    font-size: 11px;
    -unity-background-scale-mode: scale-to-fit;
    background-size: 18px 18px;
    background-position-x: left 2px;
    background-repeat: no-repeat;
}

/* Words over the units */

.demo-float {
    position: absolute;
    font-size: 16px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.9);
}
