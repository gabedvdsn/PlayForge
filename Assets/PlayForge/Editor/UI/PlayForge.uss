/* PlayForge's one style sheet (Decision 20). Docs/EDITOR_STYLE.md lists every value here, from the style mockups.

   Each PlayForge window and inspector root carries .pf-root and the editor's theme, .pf-theme-dark or
   .pf-theme-light, which set the variables below. The kit's controls read only those, and set nothing in C#. */

/* ─── The Dark theme ──────────────────────────────────────────────────────────────────────────────────────────────── */

.pf-theme-dark {
    --pf-panel: #383838;
    --pf-tab-strip: #282828;
    --pf-toolbar: #3C3C3C;
    --pf-header: #3E3E3E;
    --pf-line: #232323;
    --pf-inner-line: #2E2E2E;
    --pf-field: #2A2A2A;
    --pf-field-border: #212121;
    --pf-button: #585858;
    --pf-button-border: #303030;
    --pf-list-header: #353535;
    --pf-list-body: #414141;
    --pf-alternate-row: #3B3B3B;
    --pf-help-box: #414141;
    --pf-help-box-border: #2B2B2B;
    --pf-selection: #2C5D87;
    --pf-toggle-on: #46607C;
    --pf-text: #C4C4C4;
    --pf-strong-text: #D2D2D2;
    --pf-secondary-text: #B0B0B0;
    --pf-button-text: #EEEEEE;
    --pf-link: #81B4FF;

    --pf-type-ability: #80ADE1;
    --pf-type-effect: #A979E0;
    --pf-type-entity: #D26BAC;
    --pf-type-item: #4AD077;
    --pf-type-attribute: #A8E8E6;
    --pf-type-attribute-set: #88C8D8;

    --pf-warning: #DBB468;
    --pf-warning-text: #DBB468;
    --pf-destructive: #EA8A85;
}

/* ─── The Light theme ─────────────────────────────────────────────────────────────────────────────────────────────── */

.pf-theme-light {
    --pf-panel: #C8C8C8;
    --pf-tab-strip: #A5A5A5;
    --pf-toolbar: #CBCBCB;
    --pf-header: #D5D5D5;
    --pf-line: #999999;
    --pf-inner-line: #B5B5B5;
    --pf-field: #F0F0F0;
    --pf-field-border: #A5A5A5;
    --pf-button: #E4E4E4;
    --pf-button-border: #A0A0A0;
    --pf-list-header: #CDCDCD;
    --pf-list-body: #DEDEDE;
    --pf-alternate-row: #CDCDCD;
    --pf-help-box: #DCDCDC;
    --pf-help-box-border: #ABABAB;
    --pf-selection: #3A72B0;
    --pf-toggle-on: #9DB7D8;
    --pf-text: #1F1F1F;
    --pf-strong-text: #090909;
    --pf-secondary-text: #4A4A4A;
    --pf-button-text: #090909;
    --pf-link: #0A4FA8;

    --pf-type-ability: #1757A0;
    --pf-type-effect: #4F277E;
    --pf-type-entity: #B61B7D;
    --pf-type-item: #1D6033;
    --pf-type-attribute: #1F5F5D;
    --pf-type-attribute-set: #13687E;

    /* The palette's #83601B is too faint for 12 px text on Light's neutrals */
    --pf-warning: #D9A21B;
    --pf-warning-text: #6B4C10;
    --pf-destructive: #902E28;
}

/* ─── Text ────────────────────────────────────────────────────────────────────────────────────────────────────────── */

.pf-root .pf-strong {
    color: var(--pf-strong-text);
}

.pf-root .pf-secondary {
    color: var(--pf-secondary-text);
}

/* A unit follows its field in full, in secondary text, as in "6 seconds" */
.pf-root .pf-unit {
    color: var(--pf-secondary-text);
    padding-left: 6px;
    -unity-text-align: middle-left;
}

/* ─── Glyphs: inline vector icons on Unity's 16 px grid, drawn in their color ────────────────────────────────────── */

.pf-root .pf-glyph {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--pf-text);
}

/* The mark cut into a filled glyph, such as the warning triangle's: the panel in Dark, the text in Light */
.pf-theme-dark .pf-glyph {
    --pf-glyph-cutout: #383838;
}

.pf-theme-light .pf-glyph {
    --pf-glyph-cutout: #1F1F1F;
}

/* An asset type's color goes in its icon and nowhere else */
.pf-root .pf-type-icon--ability { color: var(--pf-type-ability); }
.pf-root .pf-type-icon--effect { color: var(--pf-type-effect); }
.pf-root .pf-type-icon--entity { color: var(--pf-type-entity); }
.pf-root .pf-type-icon--item { color: var(--pf-type-item); }
.pf-root .pf-type-icon--attribute { color: var(--pf-type-attribute); }
.pf-root .pf-type-icon--attribute-set { color: var(--pf-type-attribute-set); }

.pf-root .pf-glyph--warning {
    color: var(--pf-warning);
}

.pf-root .pf-glyph--destructive {
    color: var(--pf-destructive);
}

/* ─── Icon buttons: a glyph in a flat button ──────────────────────────────────────────────────────────────────────── */

.pf-root .pf-icon-button {
    width: 20px;
    height: 18px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.pf-root .pf-icon-button .pf-glyph {
    width: 14px;
    height: 14px;
}

/* ─── The asset header: the type icon, the asset's name, its type and tag, then its actions ────────────────────────── */

.pf-root .pf-asset-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    /* It reaches the Inspector's edges, past the root's own margins */
    margin-left: -9px;
    margin-right: -9px;
    padding: 8px 6px 8px 8px;
    background-color: var(--pf-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--pf-line);
}

/* The header stays at the top of the Inspector while the content scrolls under it (Decision 29). It's placed over
   the content, and a space of its height holds its place at the top */
.pf-root .pf-asset-header--sticky {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
}

.pf-root .pf-asset-header-space {
    flex-shrink: 0;
}

.pf-root .pf-asset-header__icon {
    width: 32px;
    height: 32px;
    margin-right: 8px;
}

.pf-root .pf-asset-header__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.pf-root .pf-asset-header__name {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--pf-strong-text);
    margin: 0;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pf-root .pf-asset-header__subtitle {
    color: var(--pf-secondary-text);
    margin: 0;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pf-root .pf-asset-header__button {
    height: 20px;
    margin: 0 0 0 8px;
    flex-shrink: 0;
}

.pf-root .pf-asset-header .pf-icon-button {
    width: 20px;
    height: 20px;
    margin-left: 2px;
}

/* ─── Sections: Unity's foldout headers, with Import, Clear and Help always showing ───────────────────────────────── */

.pf-root .pf-section {
    flex-shrink: 0;
    /* A section reaches the Inspector's edges, as the asset header does */
    margin-left: -9px;
    margin-right: -9px;
}

.pf-root .pf-section__header {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding: 0 4px 0 2px;
    background-color: var(--pf-header);
    border-top-width: 1px;
    border-top-color: var(--pf-line);
}

.pf-root .pf-section__arrow {
    width: 16px;
    height: 16px;
}

.pf-root .pf-section__arrow .pf-glyph {
    width: 10px;
    height: 10px;
}

/* The title can shrink to nothing and ends in an ellipsis, while the values on its right never shrink */
.pf-root .pf-section__title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0 0 0 2px;
    -unity-font-style: bold;
    color: var(--pf-strong-text);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* A collapsed section's one-line summary, such as "Levels 1–5" */
.pf-root .pf-section__summary {
    flex-shrink: 0;
    margin: 0;
    padding: 0 6px 0 0;
    color: var(--pf-secondary-text);
    display: none;
}

.pf-root .pf-section--collapsed > .pf-section__header > .pf-section__summary {
    display: flex;
}

/* A count a section shows beside its title, such as an attribute set's size */
.pf-root .pf-section__count {
    flex-shrink: 0;
    margin: 0;
    padding: 0 6px 0 0;
    color: var(--pf-secondary-text);
}

/* The content indents 18 px, past the foldout arrow */
.pf-root .pf-section__content {
    padding: 4px 8px 8px 18px;
}

.pf-root .pf-section--collapsed > .pf-section__content {
    display: none;
}

/* ─── Fields: values shown but not edited, rows of buttons, messages and notes ───────────────────────────────────── */

/* A value the inspector shows but doesn't edit, such as the asset tag: Unity's text field, read-only and without its
   box, in secondary text, so the value can still be selected and copied */
.pf-root .pf-value-field > .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--pf-secondary-text);
}

.pf-root .pf-value-field > .unity-base-text-field__input .unity-text-element {
    color: var(--pf-secondary-text);
}

/* A value that disagrees with what it should be, such as a stored asset tag the name no longer gives */
.pf-root .pf-value-field--warning > .unity-base-text-field__input,
.pf-root .pf-value-field--warning > .unity-base-text-field__input .unity-text-element {
    color: var(--pf-warning-text);
}

/* The button that sets such a value right */
.pf-root .pf-value-field__button {
    flex-shrink: 0;
    margin: 0 0 0 4px;
}

/* Buttons that share a row, each taking an equal part */
.pf-root .pf-button-row {
    flex-direction: row;
    margin-top: 4px;
}

/* Each clips its text with an ellipsis when the row is short of room */
.pf-root .pf-button-row > .unity-button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* ─── References: Unity's object field, with Open or New beside it (ED-38) ───────────────────────────────────────── */

.pf-root .pf-reference {
    flex-direction: row;
    align-items: center;
}

.pf-root .pf-reference > .unity-object-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.pf-root .pf-reference__action {
    flex-shrink: 0;
    margin: 0 0 0 4px;
}

/* How an effect takes its levels, on a line under its field */
.pf-root .pf-link-line {
    flex-direction: row;
    align-items: center;
    min-height: 18px;
    margin: 0 0 2px 0;
}

.pf-root .pf-link-line .pf-glyph {
    width: 12px;
    height: 12px;
    margin-right: 4px;
}

.pf-root .pf-link-line__text {
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    color: var(--pf-secondary-text);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pf-root .pf-link-line__button {
    flex-shrink: 0;
    margin: 0 0 0 6px;
}

/* A field that depends on another indents its label 14 px under it, as Equipped Too does under Allow Duplicates. A
   property field's own field takes the indent too, as Ticks does under Periodic Ticks */
.pf-root .pf-dependent > .unity-base-field__label,
.pf-root .pf-dependent > .unity-base-field > .unity-base-field__label {
    padding-left: 14px;
}

/* A field on a line with a note after it, such as why the field waits */
.pf-root .pf-field-row {
    flex-direction: row;
    align-items: center;
}

.pf-root .pf-field-row > .unity-base-field {
    flex-grow: 0;
    flex-shrink: 0;
}

.pf-root .pf-field-note {
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0 0 0 8px;
    color: var(--pf-secondary-text);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* A starting item: the item, then its Equip checkbox, on one row */
.pf-root .pf-starting-item {
    flex-direction: row;
    align-items: center;
}

.pf-root .pf-starting-item__item {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.pf-root .pf-starting-item__equip {
    flex-shrink: 0;
    margin: 0 0 0 6px;
}

/* ─── An attribute set element: a foldout row with the attribute, then its fields (ED-39) ───────────────────────── */

.pf-root .pf-element {
    margin: 2px 0;
}

.pf-root .pf-element__header {
    flex-direction: row;
    align-items: center;
}

.pf-root .pf-element__arrow {
    width: 16px;
    height: 16px;
    margin-right: 2px;
}

.pf-root .pf-element__arrow .pf-glyph {
    width: 10px;
    height: 10px;
}

.pf-root .pf-element__attribute {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* The one line a folded element shows, under the attribute */
.pf-root .pf-element__summary {
    display: none;
    margin: 0;
    padding: 0 0 2px 18px;
    color: var(--pf-secondary-text);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pf-root .pf-element--collapsed > .pf-element__summary {
    display: flex;
}

.pf-root .pf-element__content {
    padding: 2px 0 4px 18px;
}

.pf-root .pf-element--collapsed > .pf-element__content {
    display: none;
}

/* A button at the end of the foldout row, such as an impact's Remove (ED-3) */
.pf-root .pf-element__action {
    flex-shrink: 0;
    margin: 0 0 0 4px;
}

/* A contained effect: when it's applied, then the effect, on one row */
.pf-root .pf-contained-effect {
    flex-direction: row;
    align-items: center;
}

.pf-root .pf-contained-effect__policy {
    width: 96px;
    flex-shrink: 0;
    margin-left: 0;
}

.pf-root .pf-contained-effect__effect {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* A two-button switch, as Current and Base: the button shown takes the pressed toolbar toggle's color */
.pf-root .pf-segmented {
    flex-direction: row;
    margin: 4px 0 2px 0;
}

.pf-root .pf-segmented > .unity-button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
}

.pf-root .pf-segmented > .pf-segmented__selected {
    background-color: var(--pf-toggle-on);
}

/* ─── Tables: a header row, then rows that alternate, inside an outline, as the Entity mockup's attributes ─────────── */

.pf-root .pf-table {
    margin-top: 4px;
    border-width: 1px;
    border-color: var(--pf-line);
    border-radius: 3px;
    overflow: hidden;
}

.pf-root .pf-table__header,
.pf-root .pf-table__row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    flex-shrink: 0;
}

.pf-root .pf-table__header {
    background-color: var(--pf-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--pf-line);
}

.pf-root .pf-table__row {
    background-color: var(--pf-panel);
}

.pf-root .pf-table__row--alternate {
    background-color: var(--pf-alternate-row);
}

.pf-root .pf-table__cell {
    margin: 0;
    padding: 0 6px;
    color: var(--pf-text);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* The name can shrink to nothing and ends in an ellipsis, while the columns on its right keep their width */
.pf-root .pf-table__cell--name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.pf-root .pf-table__cell--name .pf-glyph {
    width: 12px;
    height: 12px;
    margin-right: 4px;
}

.pf-root .pf-table__name {
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    color: var(--pf-strong-text);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pf-root .pf-table__cell--number {
    width: 72px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.pf-root .pf-table__cell--range {
    width: 88px;
    flex-shrink: 0;
}

.pf-root .pf-table__header > .pf-table__cell--number,
.pf-root .pf-table__header > .pf-table__cell--range {
    border-left-width: 1px;
    border-left-color: var(--pf-line);
}

.pf-root .pf-table__row > .pf-table__start {
    color: var(--pf-strong-text);
}

.pf-root .pf-table__row > .pf-table__range {
    color: var(--pf-secondary-text);
}

/* ─── Tag requirements: the Effect mockup's table, a row for each group, a cell for what it requires and what it must
   not have, each opening its list under the table (ED-37) ─────────────────────────────────────────────────────────── */

.pf-root .pf-requirements__when {
    width: 84px;
    flex-shrink: 0;
}

.pf-root .pf-table__header > .pf-requirements__tags {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    border-left-width: 1px;
    border-left-color: var(--pf-line);
}

/* A cell is a flat button that fills its part of the row, and clips its tags with an ellipsis */
.pf-root .pf-requirements__cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 20px;
    margin: 0;
    padding: 0 6px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--pf-text);
    -unity-text-align: middle-left;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pf-root .pf-requirements__cell--none {
    color: var(--pf-secondary-text);
}

.pf-root .pf-requirements__cell--open {
    background-color: var(--pf-selection);
}

.pf-root .pf-requirements__editor {
    margin-top: 4px;
}

/* ─── The Import window: choose a source, then the fields that differ, then import them as one Undo step (ED-32) ──── */

.pf-root.pf-import {
    flex-grow: 1;
    background-color: var(--pf-panel);
}

.pf-root .pf-import__into {
    flex-direction: row;
    align-items: center;
    height: 30px;
    flex-shrink: 0;
    padding: 0 10px;
    background-color: var(--pf-toolbar);
    border-bottom-width: 1px;
    border-bottom-color: var(--pf-line);
}

.pf-root .pf-import__into > * {
    margin: 0 6px 0 0;
    padding: 0;
}

.pf-root .pf-import__into > .pf-glyph {
    width: 14px;
    height: 14px;
}

.pf-root .pf-import__name {
    -unity-font-style: bold;
    color: var(--pf-strong-text);
}

.pf-root .pf-import__kind {
    color: var(--pf-secondary-text);
}

.pf-root .pf-import__body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.pf-root .pf-import__sources {
    width: 290px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: var(--pf-line);
}

.pf-root .pf-import__fields {
    flex-grow: 1;
    min-width: 0;
    padding: 0 10px;
}

.pf-root .pf-import__step {
    flex-direction: row;
    align-items: center;
    height: 26px;
    flex-shrink: 0;
    padding: 0 10px;
}

.pf-root .pf-import__fields > .pf-import__step {
    padding: 0;
}

/* The step's number, in a ring, as the mockup has it */
.pf-root .pf-import__step-number {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin: 0 6px 0 0;
    padding: 0;
    border-width: 1px;
    border-color: var(--pf-field-border);
    border-radius: 8px;
    -unity-text-align: middle-center;
    color: var(--pf-strong-text);
}

.pf-root .pf-import__step-text {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    -unity-font-style: bold;
    color: var(--pf-strong-text);
}

.pf-root .pf-import__search {
    width: auto;
    margin: 0 8px 6px 8px;
}

.pf-root .pf-import__list {
    flex-grow: 1;
    border-top-width: 1px;
    border-top-color: var(--pf-line);
}

.pf-root .pf-import__group {
    height: 20px;
    margin: 0;
    padding: 0 8px;
    -unity-text-align: middle-left;
    background-color: var(--pf-header);
    color: var(--pf-secondary-text);
    border-bottom-width: 1px;
    border-bottom-color: var(--pf-line);
}

/* A source: its type icon, its name, then its tag, which clips first */
.pf-root .pf-import__source {
    flex-direction: row;
    align-items: center;
    height: 20px;
    margin: 0;
    padding: 0 8px;
    border-width: 0;
    border-radius: 0;
    background-color: var(--pf-panel);
}

.pf-root .pf-import__source--alternate {
    background-color: var(--pf-alternate-row);
}

.pf-root .pf-import__source--selected {
    background-color: var(--pf-selection);
}

.pf-root .pf-import__source > .pf-glyph {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    margin-right: 4px;
}

.pf-root .pf-import__source-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    color: var(--pf-text);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pf-root .pf-import__source-tag {
    flex-shrink: 1;
    min-width: 0;
    max-width: 45%;
    margin: 0 0 0 6px;
    padding: 0;
    color: var(--pf-secondary-text);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pf-root .pf-import__matching {
    flex-shrink: 0;
    margin: 0;
}

/* A field's row: its checkbox, its name, the value now, the source's, and Add for a list */
.pf-root .pf-import__check {
    width: 28px;
    flex-shrink: 0;
    margin: 0;
    justify-content: center;
}

.pf-root .pf-import__field,
.pf-root .pf-import__value {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.pf-root .pf-import__now {
    color: var(--pf-secondary-text);
}

.pf-root .pf-import__append {
    width: 52px;
    flex-shrink: 0;
    margin: 0;
}

.pf-root .pf-import__row--same > .pf-table__cell {
    color: var(--pf-secondary-text);
}

.pf-root .pf-import__note {
    margin: 4px 0;
}

.pf-root .pf-import__footer {
    flex-direction: row;
    align-items: center;
    height: 36px;
    flex-shrink: 0;
    padding: 0 10px;
    background-color: var(--pf-toolbar);
    border-top-width: 1px;
    border-top-color: var(--pf-line);
}

.pf-root .pf-import__changes {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* ─── A magnitude or scaler field: its name and kind, its number or range, its menu, then its scaler (ED-33) ───────── */

.pf-root .pf-magnitude__row {
    flex-direction: row;
    align-items: center;
}

.pf-root .pf-magnitude__number,
.pf-root .pf-magnitude__kind-labelled {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.pf-root .pf-magnitude__unit {
    flex-shrink: 0;
    margin: 0 4px 0 2px;
    padding: 0;
    color: var(--pf-secondary-text);
}

.pf-root .pf-magnitude__kind {
    width: 96px;
    flex-shrink: 0;
    margin-left: 4px;
}

/* The range a scaler gives, as "6–8 s", which clips before the kind does */
.pf-root .pf-magnitude__range {
    flex-shrink: 1;
    min-width: 0;
    max-width: 40%;
    margin: 0 0 0 6px;
    padding: 0;
    color: var(--pf-secondary-text);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pf-root .pf-magnitude__menu {
    flex-shrink: 0;
    margin-left: 4px;
}

/* A scaler's content indents past the label column's start, under the field it belongs to */
.pf-root .pf-magnitude__body,
.pf-root .pf-scaler-field__content {
    padding-left: 14px;
}

.pf-root .pf-magnitude__combine {
    flex-direction: row;
    align-items: center;
}

.pf-root .pf-magnitude__combine > .unity-base-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.pf-root .pf-magnitude__combine > .pf-magnitude__combine-number {
    flex-grow: 0;
    width: 64px;
    flex-shrink: 0;
    margin-left: 4px;
}

/* The values per level: a row of levels over a row of values, ten to a row, inside an outline */
.pf-root .pf-scaler-table {
    margin: 2px 0;
}

.pf-root .pf-scaler-table > #Grid {
    border-width: 1px;
    border-color: var(--pf-line);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 2px;
}

.pf-root .pf-scaler-table__levels,
.pf-root .pf-scaler-table__values {
    flex-direction: row;
    align-items: center;
    height: 20px;
}

.pf-root .pf-scaler-table__levels {
    background-color: var(--pf-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--pf-line);
}

.pf-root .pf-scaler-table__head {
    width: 44px;
    flex-shrink: 0;
    margin: 0;
    padding: 0 6px;
    color: var(--pf-secondary-text);
}

.pf-root .pf-scaler-table__cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
    padding: 0 2px;
    overflow: hidden;
}

.pf-root .pf-scaler-table__levels > .pf-scaler-table__cell {
    -unity-text-align: middle-center;
    color: var(--pf-secondary-text);
}

/* A read-only curve: the line takes the color, the guides the border color, and a second series its own color */
.pf-root .pf-curve {
    height: 48px;
    margin: 2px 0 4px 0;
    color: var(--pf-link);
    border-bottom-color: var(--pf-line);
}

.pf-root .pf-curve__second {
    position: absolute;
    width: 0;
    height: 0;
    color: var(--pf-secondary-text);
}

/* A shared scaler's curve, with its range and how many fields share it beside it */
.pf-root .pf-scaler-shared {
    flex-direction: row;
    align-items: center;
}

.pf-root .pf-scaler-shared > .pf-curve {
    width: 96px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 8px;
}

.pf-root .pf-scaler-shared__text {
    flex-grow: 1;
    min-width: 0;
}

.pf-root .pf-scaler-shared__range,
.pf-root .pf-scaler-shared__uses {
    margin: 0;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pf-root .pf-scaler-shared__uses {
    color: var(--pf-secondary-text);
}

/* A Scaler asset's inspector: its name, then its kind and uses */
.pf-root .pf-scaler-asset__header {
    padding: 6px 0;
}

.pf-root .pf-scaler-asset__name {
    -unity-font-style: bold;
    color: var(--pf-strong-text);
}

.pf-root .pf-scaler-asset__about {
    color: var(--pf-secondary-text);
}

.pf-root .pf-used-by__field {
    flex-shrink: 1;
    min-width: 0;
    margin: 0 0 0 8px;
    padding: 0;
    color: var(--pf-secondary-text);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* A small dialog, as Save as Scaler Asset: its fields, then its buttons at the end */
.pf-root.pf-dialog {
    padding: 8px 10px;
    background-color: var(--pf-panel);
}

.pf-root .pf-dialog__row {
    flex-direction: row;
    align-items: center;
}

.pf-root .pf-dialog__grow {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.pf-root .pf-dialog__footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 8px;
}

/* A message is a Unity help box, in the flow under the field it is about */
.pf-root .unity-help-box {
    background-color: var(--pf-help-box);
    border-color: var(--pf-help-box-border);
}

/* A line where values would be, such as in a multiple selection */
.pf-root .pf-note {
    margin: 2px 0;
    padding: 0;
    color: var(--pf-secondary-text);
    white-space: normal;
}

/* ─── Used By: the assets that refer to this one, each a row that selects it ─────────────────────────────────────── */

.pf-root .pf-used-by__row {
    flex-direction: row;
    align-items: center;
    height: 20px;
}

.pf-root .pf-used-by__row .pf-glyph {
    width: 14px;
    height: 14px;
    margin-right: 6px;
}

.pf-root .pf-used-by__name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    color: var(--pf-link);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pf-root .pf-used-by__none {
    margin: 0;
    padding: 0;
    color: var(--pf-secondary-text);
}

/* ─── Settings pages: Project Settings and Preferences, each a title, then headings over Unity's own fields ───────── */

.pf-root .pf-settings {
    flex-grow: 1;
    padding: 1px 10px 10px 10px;
}

.pf-root .pf-settings__title {
    margin: 0 0 6px 0;
    padding: 0;
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--pf-strong-text);
}

.pf-root .pf-settings__heading {
    margin: 12px 0 4px 0;
    padding: 0;
    -unity-font-style: bold;
    color: var(--pf-strong-text);
}

.pf-root .pf-settings__buttons {
    flex-direction: row;
    margin-top: 6px;
}

/* A table row that holds fields takes their height */
.pf-root .pf-settings__row {
    height: auto;
    min-height: 22px;
}

.pf-root .pf-settings__type {
    width: 140px;
    flex-grow: 0;
    flex-shrink: 0;
}

.pf-root .pf-settings__folder {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.pf-root .pf-settings__folder-field {
    flex-direction: row;
    align-items: center;
}

.pf-root .pf-settings__folder-field > .unity-button {
    flex-shrink: 0;
    margin: 0 0 0 2px;
}

.pf-root .pf-settings__affix {
    width: 110px;
    flex-grow: 0;
    flex-shrink: 0;
}

.pf-root .pf-settings__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
}

.pf-root .pf-settings__defaults {
    margin-top: 2px;
}
