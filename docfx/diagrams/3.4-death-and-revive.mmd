rth["Runtime hub: Relay.Terminate(),<br/>which queues"]:::general
wt(["hub.WhenTerminate(), GASCore.WhenTerminate()<br/>components End, services End, transfers given back,<br/>sides cleared, AbilitySystem.ShutDown, ForgeEntities.Remove"]):::terminator
rv(["Revive, Stay only: a RespawnTimer's countdown,<br/>ReviveOnRemovalEffectWorker, or gas.Revive(at)"]):::terminator
