{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../Assets/PlayForge",
          "files": [
            "Runtime/**/*.cs",
            "Editor/**/*.cs",
            "TestKit/**/*.cs"
          ]
        }
      ],
      "references": [
        {
          "src": "obj/refs",
          "files": [
            "*.dll"
          ]
        }
      ],
      "properties": {
        "DefineConstants": "UNITY_EDITOR;UNITY_TESTS_FRAMEWORK;PLAYFORGE_INPUT_SYSTEM;ENABLE_INPUT_SYSTEM;ENABLE_LEGACY_INPUT_MANAGER"
      },
      "dest": "obj/api",
      "outputFormat": "mref",
      "memberLayout": "samePage",
      "namespaceLayout": "flattened",
      "enumSortOrder": "declaringOrder",
      "disableGitFeatures": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml"
        ]
      },
      {
        "files": [
          "guides/**/*.md",
          "guides/toc.yml"
        ]
      },
      {
        "files": [
          "api/*.yml",
          "api/index.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "overwrite": [
      {
        "files": [
          "apidoc/*.md"
        ]
      }
    ],
    "xref": [
      "obj/unity.xrefmap.yml"
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appName": "PlayForge",
      "_appTitle": "PlayForge",
      "_appFooter": "PlayForge 1.0.0 · Far Emerald",
      "_enableSearch": true,
      "_disableContribution": true,
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/logo.svg"
    }
  }
}
